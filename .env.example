# ==============================================================================
# BrightPath CRM — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` in the project root:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTES:
# 1. Variables prefixed with `VITE_` are bundled into the public browser build.
# 2. NEVER add your Supabase `service_role` key or database password here.
# 3. Only add the public `anon` / `publishable` client key.
# ==============================================================================

# Supabase Project URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-token-here
